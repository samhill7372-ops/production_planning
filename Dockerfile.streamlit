# Production Dockerfile for Streamlit Main UI
# Build context: project root
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Create non-root user for security
RUN useradd -m -u 1000 appuser

WORKDIR /app

# Install dependencies (cache layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app.py .
COPY src/ /app/src/
COPY config/ /app/config/
COPY .streamlit/ /app/.streamlit/

# Copy model folders needed by the app
COPY models/2024/ /app/models/2024/
COPY models/2025/ /app/models/2025/
COPY models/2year/ /app/models/2year/
# Multi_output: reassemble split parts into single file
COPY models/multi_output/baseline_yield_model.part_* /app/models/multi_output/
COPY models/multi_output/training_template.joblib /app/models/multi_output/
RUN cat /app/models/multi_output/baseline_yield_model.part_* > /app/models/multi_output/baseline_yield_model.joblib && \
    rm /app/models/multi_output/baseline_yield_model.part_*

# Copy root-level model files (all_models, output_classifier, encoders, etc.)
COPY models/*.joblib /app/models/
COPY models/*.csv /app/models/
COPY models/*.json /app/models/

# Set ownership
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

EXPOSE 8501

# Use PORT from Railway, default to 8501
CMD sh -c "streamlit run app.py --server.port=${PORT:-8501} --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false --server.maxUploadSize=5000 --server.maxMessageSize=5000"
